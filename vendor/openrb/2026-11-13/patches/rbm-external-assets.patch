+    /// [`KeyTable::embedded`] with the window's bytes given by the caller instead of taken from
+    /// [`embedded::WINDOW_BYTES`] (the `external-assets` build has none).
+    pub fn with_window(rbm: &Rbm, window: &[u8; embedded::WINDOW_LEN]) -> Option<KeyTable> {
+        let mut t = KeyTable {
+            bytes: Box::new([0u8; TABLE_LEN]),
+            known: [0, 0],
+        };
+        for (j, off) in rbm.key_pages().into_iter().enumerate() {
+            if off == embedded::WINDOW {
+                t.bytes[j * PAGE..j * PAGE + embedded::WINDOW_LEN].copy_from_slice(window);
+                t.known[j] = embedded::WINDOW_LEN;
+            }
+        }
+        (t.known != [0, 0]).then_some(t)
+    }
