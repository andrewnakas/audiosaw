# Cloudflare Pages headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Permissions-Policy note: microphone is (self), not (). An empty allowlist
# denies the permission to this origin's own documents, which silently broke
# /voice-recorder — the browser never even showed its prompt.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Long-cache static assets
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.ico
  Cache-Control: public, max-age=604800

# Cloudflare Pages will not let us shorten the browser TTL on a .js file. Both
# `no-cache` and `max-age=0` come back as `max-age=14400`, while the identical
# rule on /manifest.webmanifest keeps its `max-age=3600` — so it is the
# extension, not the rule, and a marker header proved the rule itself matches.
#
# The rule stays because it is correct and costs nothing if Pages changes. What
# actually keeps the worker fresh is the registration: js/pwa.js registers with
# `updateViaCache: 'none'`, which makes the browser bypass its HTTP cache when
# fetching the script, and calls reg.update() once per load. must-revalidate
# plus the ETag keeps the edge honest.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# WASM needs the right MIME type for ffmpeg.wasm
/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# HTML: short cache so updates roll out fast
/*.html
  Cache-Control: public, max-age=300, must-revalidate
/
  Cache-Control: public, max-age=300, must-revalidate

# Kept even though the site currently serves no ads: an AdSense account with a
# site that used to have it flags a removed ads.txt as a misconfiguration.
/ads.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=86400
/robots.txt
  Content-Type: text/plain
/sitemap.xml
  Content-Type: application/xml
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# IndexNow key file — must be served as plain text at the site root.
/*.txt
  Content-Type: text/plain; charset=utf-8

# The stem splitter runs a neural network through onnxruntime-web. Multi-threaded
# inference needs SharedArrayBuffer, which needs the page to be cross-origin
# isolated. Scoped to this one page: applying COEP site-wide would break the
# analytics embed everywhere else.
#
# `credentialless` rather than `require-corp` so cross-origin subresources that
# don't send CORP (analytics) still load, just without credentials.
/stem-splitter
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
/stem-splitter.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# A dedicated worker spawned from a cross-origin-isolated page must ITSELF be
# delivered with a compatible COEP header. Without this the worker fails to be
# created at all, with an opaque error and before its first line runs — which
# looks exactly like the script being broken.
/js/stem-worker.js
  Cross-Origin-Embedder-Policy: credentialless

# ONNX Runtime's wasm binaries.
#
# The COEP header here is what makes multi-threaded CPU inference possible.
# ORT spawns its own pthread workers from these files, and a nested worker needs
# a compatible COEP just as much as the top-level one does. Without it, asking
# for more than one thread hangs session creation forever — which is why the
# stem splitter's CPU fallback appeared to be broken. With it, threads work and
# the CPU path is roughly three times faster.
/vendor/ort/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
